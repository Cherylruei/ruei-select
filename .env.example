
# ── Supabase ──────────────────────────────────────────────────
# 取得方式：Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...     # 只用於 server，絕對不可 NEXT_PUBLIC

# ── LINE LIFF ─────────────────────────────────────────────────
# 取得方式：LINE Developers Console > LIFF > LIFF ID
NEXT_PUBLIC_LIFF_ID=1234567890-abcdefgh

# ── LINE Login（OAuth callback 用）────────────────────────────
# 取得方式：LINE Developers Console > Channel ID / Channel Secret
LINE_CHANNEL_ID=1234567890
LINE_CHANNEL_SECRET=abcdef1234567890abcdef1234567890

# ── Claude API（AI 文案優化）──────────────────────────────────
# 取得方式：https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-...               # 只用於 server

# ── ExchangeRate API（匯率，Sprint 2 使用）────────────────────
# 取得方式：https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=xxxx

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
